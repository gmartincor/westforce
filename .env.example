# =============================================================================
# .env.example - Configuración de Westforce
# =============================================================================

# CONFIGURACIÓN GENERAL
ENVIRONMENT=development
DEBUG=True
LOAD_TEST_DATA=True
SECRET_KEY=django-insecure-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*.localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# EMPRESA - INFORMACIÓN BÁSICA
COMPANY_NAME=Westforce Removals
COMPANY_TAGLINE=Professional Australian Removals Company Management System
COMPANY_PHONE=+61-8-9234-5678
COMPANY_PHONE_DISPLAY=(08) 9234 5678
COMPANY_EMAIL=info@westforceremovals.com.au
COMPANY_ESTABLISHED_YEAR=2020

# EMAIL - RESEND CONFIGURATION
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=onboarding@resend.dev
QUOTE_RECIPIENT_EMAIL=info@westforceremovals.com.au

# EMPRESA - UBICACIÓN
COMPANY_ADDRESS_CITY=Perth
COMPANY_ADDRESS_STATE=WA
COMPANY_ADDRESS_COUNTRY=AU
COMPANY_LATITUDE=-31.9505
COMPANY_LONGITUDE=115.8605

# EMPRESA - REPUTACIÓN
COMPANY_RATING=4.8
COMPANY_REVIEW_COUNT=127

# SEO - META TAGS
SEO_META_TITLE=Westforce Removals - Professional Moving Services Perth | Local & Interstate Movers
SEO_META_DESCRIPTION=Professional moving and removalist services in Perth, Western Australia. Local and interstate relocations with expert care. Get your free quote today.
SEO_OG_IMAGE_PATH=images/landing/hero/View-of-Perth-City-as-seen-from-Kings-Park.jpg

# BASE DE DATOS
DB_NAME=crm_nutricion_pro
DB_USER=guillermomartincorrea
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CACHE (REDIS) - Opcional
REDIS_URL=redis://localhost:6379/0

# GOOGLE ANALYTICS & ADS
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_PHONE_CONVERSION_LABEL=
GOOGLE_ADS_EMAIL_CONVERSION_LABEL=
GOOGLE_ADS_QUOTE_CONVERSION_LABEL=

# RENDER MCP SERVER
RENDER_API_KEY=

