# =============================================================================
# Variables de entorno para despliegue en Hetzner - Westforce Removals
# Servidor: CX23 (2 vCPU, 4GB RAM, 40GB SSD)
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a .env: cp .env.hetzner.example .env
# 2. Rellena los valores marcados con <SECRETO>
# 3. Para generar nuevo SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(50))"
# 4. Para generar DB_PASSWORD: python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# === DJANGO CORE ===
# SECRETO: Genera uno nuevo con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<SECRETO>
DJANGO_SETTINGS_MODULE=config.settings.production
ENVIRONMENT=production
DEBUG=False

# === DOMINIO ===
DOMAIN=westforceremovals.com
ALLOWED_HOSTS=westforceremovals.com,www.westforceremovals.com
CSRF_TRUSTED_ORIGINS=https://westforceremovals.com,https://www.westforceremovals.com

# === BASE DE DATOS (local en Docker) ===
DB_NAME=westforce_removals
DB_USER=westforce
# SECRETO: Genera un password seguro para la BD local
DB_PASSWORD=<SECRETO>
DB_HOST=postgres
DB_PORT=5432

# === GUNICORN (ajustar según recursos del servidor) ===
# CX23 recomendado: 3 workers (2 vCPU * 1.5)
GUNICORN_WORKERS=3
LOG_LEVEL=info

# === SSL / LET'S ENCRYPT ===
ACME_EMAIL=westforce.analytics@gmail.com

# === EMPRESA ===
COMPANY_NAME=Westforce Removals Company
COMPANY_TAGLINE=Professional Australian Removals Company Management System
COMPANY_EMAIL=westforce.analytics@gmail.com
COMPANY_PHONE=+61-8-9234-5678
COMPANY_PHONE_DISPLAY=(08) 9234 5678
COMPANY_ADDRESS_CITY=Perth
COMPANY_ADDRESS_STATE=WA
COMPANY_ADDRESS_COUNTRY=AU
COMPANY_LATITUDE=-31.9505
COMPANY_LONGITUDE=115.8605
COMPANY_RATING=4.8
COMPANY_REVIEW_COUNT=127
COMPANY_ESTABLISHED_YEAR=2020

# === EMAIL (Resend) ===
# SECRETO: Obtén tu API key en https://resend.com/api-keys
RESEND_API_KEY=<SECRETO>
RESEND_FROM_EMAIL=onboarding@resend.dev
QUOTE_RECIPIENT_EMAIL=westforce.analytics@gmail.com

# === ANALYTICS ===
GOOGLE_ANALYTICS_ID=G-5JYBXY41NK
GOOGLE_TAG_MANAGER_ID=GTM-PRPVKBMB
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_PHONE_CONVERSION_LABEL=
GOOGLE_ADS_EMAIL_CONVERSION_LABEL=
GOOGLE_ADS_QUOTE_CONVERSION_LABEL=

# === MONITORIZACIÓN (Healthchecks.io) ===
# Crear checks en https://healthchecks.io y copiar las URLs
HEALTHCHECK_HEARTBEAT_URL=<CREAR-EN-HEALTHCHECKS.IO>
HEALTHCHECK_FAILURE_URL=<CREAR-EN-HEALTHCHECKS.IO>/fail

# === UMBRALES DE ALERTA ===
CPU_THRESHOLD=90
RAM_THRESHOLD=90
DISK_THRESHOLD=85

# === BACKUP ===
BACKUP_RETENTION_DAYS=7

# === GITHUB (para CI/CD) ===
GITHUB_REPOSITORY=gmartincor/westforce
IMAGE_TAG=latest
